# ===========================================
# BLACK VAULT - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git

# Auth (Clerk) - https://clerk.com → Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database (Neon) - https://neon.tech → Project → Connection Details
DATABASE_URL=
DIRECT_URL=

# Cache (Upstash Redis) - https://upstash.com → Database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional reliability settings (see docs/design/0005-reliability-and-money-math.md)
# open (default) = keep serving when Redis is down; closed = deny rate-limited/budgeted requests
BLACKVAULT_REDIS_FAIL_MODE=open
# Per-attempt Redis timeout in ms (default 800)
REDIS_TIMEOUT_MS=

# Optional: DATABASE_URL may be any Postgres; neon.tech URLs use Neon's HTTP driver.
# Force a driver with DATABASE_DRIVER=neon|pg
DATABASE_DRIVER=

# Optional: override a provider's upstream origin (operator-only), e.g. a local Ollama
# BLACKVAULT_UPSTREAM_OPENAI=http://localhost:11434

# Encryption - Run: openssl rand -hex 32
VAULT_MASTER_KEY=

# Razorpay - https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Cron Jobs
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BlackVault
